# Per-user configuration (mods folder path, FModel path, language)
config.pkl

# Python bytecode
__pycache__/
*.pyc

# Build staging folders created during export (regenerated every time)
Upack/*_P/

# UnrealPak scratch file - rewritten with absolute local paths on every pack
Upack/filelist.txt

# Paks left in Upack before they are moved to the Mods folder
Upack/*.pak

# FModel exports are never stored in the repo
Output/

# Embedded Python distribution — shipped in release zips, not in the repo
# (clone users run setup.bat instead, or grab a release)
python-3.12.6.amd64/

# FModel installed locally by setup.ps1
FModel/

# Interpreter path recorded by setup.ps1 (machine specific)
python_path.txt

# User presets — keep the folder, ignore its contents
Preset/*
!Preset/.gitkeep

# ---------------------------------------------------------------------------
# Generated artifacts. Portraits (*_CSP.png) and portrait_headers.json ARE
# committed: they are what lets the tool replace portraits offline, without
# the game .pak, Oodle or FModel. Only the bulky intermediates below are
# ignored, since they are regenerated by "Update Game Data" on demand.
# ---------------------------------------------------------------------------

# Raw texture binaries (~1 MB each) - only the 145-byte headers are kept,
# in portrait_headers.json
*_CSP.uexp
*.ubulk

# Recolored output written while building a mod
*_preview.png
*_recolored.png

# Temporary extraction folders used when rebuilding paks
colorswap_*/
*.tmp
